{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": ".web-dist",
  "rewrites": [
    { "source": "/api/rpc", "destination": "https://alibi-mystery-party.honeyspark.chatgpt.site/api/rpc" },
    { "source": "/api/health", "destination": "https://alibi-mystery-party.honeyspark.chatgpt.site/api/health" },
    { "source": "/((?!api/|assets/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
